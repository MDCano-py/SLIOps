# Copy to .env.local for local development, or .env.staging / .env.production on the server.
# NEVER commit files with real secrets. See DEPLOYMENT_NOTES.md and .env.staging.example.

NODE_ENV=development
PORT=3010
HOST=127.0.0.1

# Public URL (trailing slash required for staging/production)
# PORTAL_BASE_URL=http://127.0.0.1:3010/
# APP_BASE_PATH=

# --- Postgres (recommended for hub/vendor on staging/production) ---
# HUB_STORE_MODE=postgres
# VENDOR_STORE_MODE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/streamline_hub
# PGSSLMODE=disable

# --- WOS-93 Configurable platform (Configuration Center / visual workflows) ---
# When 0/unset: Configuration APIs return 503; legacy hub behavior unchanged.
# When 1: enables /hub/configuration/* and #/configuration (admin RBAC still required).
# CONFIGURABLE_PLATFORM_ENABLED=0

# --- Local JSON dev store (laptop only — NOT for staging) ---
# HUB_USE_LOCAL_STORE=1

# --- Auth / session ---
# SESSION_SECRET=generate-a-long-random-string-min-32-chars
# SSO_ENFORCEMENT=off
# DEMO_BYPASS=1
# ALLOW_DEV_LOGIN=1

# --- Microsoft Entra SSO (see ENTRA_SSO_SETUP.md) ---
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# --- Optional Redis/Upstash (legacy KV / dedupe when Postgres is SoR) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Amazon S3 object storage (private bucket; prefer EC2 IAM role) ---
# STORAGE_DRIVER=s3
# S3_BUCKET=your-private-bucket-name
# S3_REGION=us-east-1
# PRESIGNED_URL_EXPIRES_SECONDS=300
# Optional local/dev only (never staging/production):
# STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=./for-dev/local-object-storage
# Optional long-lived keys for local only (prefer IAM role on EC2):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Email / integrations ---
# RESEND_API_KEY=
# EMAIL_FROM=Streamline Operations Hub <notifications@yourdomain.com>
# MAINTAINX_API_KEY=
# MAINTAINX_ORG_ID=

# See .env.staging.example for the full staging variable list.
