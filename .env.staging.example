# Copy to .env.staging on the EC2 instance (never commit secrets).
# GitHub is deploy source only — this app runs on the instance behind nginx.
#
# WOS-51 / WOS-76: Staging uses AWS RDS PostgreSQL as system of record.
# Start with an EMPTY database. Run migrations before first app start.
# Do NOT run npm run db:seed, db:seed-demo, or db:validate:demo on staging.

NODE_ENV=staging
PORT=3010
HOST=0.0.0.0

# Public URL leadership will open (must match nginx path + scheme)
PORTAL_BASE_URL=https://automation.streamlinescada.com/ops-hub-staging/
APP_BASE_PATH=/ops-hub-staging

# --- Postgres / RDS (required) ---
# Provision an empty RDS database, then run: npm run db:migrate
HUB_STORE_MODE=postgres
VENDOR_STORE_MODE=postgres
HUB_USE_LOCAL_STORE=0
DATABASE_URL=postgresql://streamline_app:CHANGE_ME@your-rds-endpoint.region.rds.amazonaws.com:5432/streamline_hub
PGSSLMODE=require

# --- Queued delivery (API enqueues; hub-worker delivers) ---
INTEGRATION_DISPATCH_MODE=queued
EMAIL_DELIVERY_MODE=queued
EMAIL_NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Streamline Operations Hub <notifications@yourdomain.com>

# --- Vendor notification recipients (WOS-47) ---
VENDOR_NOTIFY_EMAIL_ADMIN=rebekah@streamlinecorp.com
# VENDOR_NOTIFY_EMAIL_REBEKAH=
VENDOR_NOTIFY_EMAIL_AP=ap@streamlinecorp.com
VENDOR_NOTIFY_EMAIL_LEGAL=dylan@streamlinecorp.com
# VENDOR_NOTIFY_EMAIL_DYLAN=

# --- Hub worker (same DATABASE_URL; PM2 process: ops-hub-staging-worker) ---
HUB_WORKER_MODE=continuous
HUB_WORKER_POLL_INTERVAL_MS=5000
HUB_WORKER_BATCH_SIZE=10
HUB_WORKER_ENABLE_INTEGRATIONS=true
HUB_WORKER_ENABLE_EMAIL=true

# --- Auth (required for staging approval) ---
SESSION_SECRET=generate-a-long-random-string-min-32-chars
SSO_ENFORCEMENT=on
DEMO_BYPASS=0
# Do not use ?_noauth=1 on staging — bypass works on localhost/development only.

# Entra ID (Microsoft SSO) — see ENTRA_SSO_SETUP.md
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Redirect URI registered in Entra:
#   https://automation.streamlinescada.com/ops-hub-staging/api/auth/callback

BOOTSTRAP_ADMIN_EMAILS=you@streamlinecorp.com
ALLOWED_EMAIL_DOMAINS=streamlinecorp.com

# Optional: emergency dev-login on staging (NOT for leadership demos)
# ALLOW_DEV_LOGIN=0

# --- Optional Redis/Upstash (legacy user/role KV, dedupe — not hub SoR when Postgres enabled) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vendor document uploads (required for WOS-46 staging smoke) ---
BLOB_READ_WRITE_TOKEN=

# --- Integrations (enable after portal + RDS smoke pass) ---
# MAINTAINX_API_KEY=
# MAINTAINX_ORG_ID=
# N8N_WEBHOOK_DEFAULT=
# N8N_WEBHOOK_REQUEST_CREATED=
# N8N_WEBHOOK_REQUEST_STATUS_CHANGED=
# (see api/lib/hub/integrations.js for full webhook env list)

# --- RDS validation from EC2 (optional write checks; not for routine use) ---
# DATABASE_URL_CONFIRM_PERSISTENCE_TEST=1

# --- Local-only commands (do NOT use on staging) ---
# npm run db:seed
# npm run db:seed-demo
# npm run db:seed-archives
# npm run db:validate:demo
