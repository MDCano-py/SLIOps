{
  "name": "streamline-maintainx-proxy",
  "version": "1.2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node scripts/production-server.js",
    "start:staging": "node scripts/production-server.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:reset": "node scripts/db/reset.js",
    "db:seed": "node scripts/db/seed.js",
    "db:validate": "node scripts/db/validate.js",
    "hub-worker": "node scripts/hub-worker.js",
    "hub-worker:once": "node scripts/hub-worker.js --once",
    "ec2-live-cutover:validate": "bash scripts/ec2-live-cutover-validate.sh",
    "health": "node -e \"require('http').get(process.env.HEALTH_URL||'http://127.0.0.1:3010/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@azure/msal-node": "^2.16.2",
    "@node-saml/node-saml": "^5.0.0",
    "@upstash/redis": "^1.34.0",
    "jszip": "^3.10.1",
    "pg": "^8.21.0"
  }
}
